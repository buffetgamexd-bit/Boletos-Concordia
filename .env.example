# =========================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - EVENTO NETWORKING
# =========================================================================

PORT=5000

# --- STRIPE KEYS ---
# Llave pública para el frontend
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Llave secreta para el backend
STRIPE_SECRET_KEY=sk_test_...

# --- CORREOS ELECTRÓNICOS (SMTP GMAIL) ---
# Cuenta de Gmail desde la que se enviarán los boletos
GMAIL_USER=tu-correo@gmail.com
# Contraseña de aplicación generada en la configuración de Google
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# Correo que recibirá notificaciones de nuevas ventas
MERCHANT_EMAIL=tu-correo-notificaciones@gmail.com

# --- GOOGLE SHEETS (REGISTRO DE VENTAS) ---
# ID de la hoja de cálculo de Google (se obtiene de la URL de tu hoja)
GOOGLE_SHEET_ID=1_xxxx-xxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxx
# Email de la cuenta de servicio de Google Cloud Console
GOOGLE_SERVICE_EMAIL=tu-cuenta-de-servicio@nombre-proyecto.iam.gserviceaccount.com
# Llave privada de la cuenta de servicio (todo en una sola línea, incluyendo saltos de línea \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
